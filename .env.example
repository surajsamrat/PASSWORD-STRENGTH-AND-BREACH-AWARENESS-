# SecureCheck Backend Server Configuration
# NEVER prefix AI API keys with VITE_ (frontend variables are bundled into client JS).

PORT=8787
CORS_ORIGIN=http://localhost:5173

# Optional: "gemini" or "openai" (auto-detected from keys if omitted)
AI_PROVIDER=gemini

# Google Gemini API key (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible API key (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Rate limiting (requests per IP per window)
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000
